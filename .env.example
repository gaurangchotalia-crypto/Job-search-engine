# Job Scraper Configuration

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Scraper Settings
SCRAPER_HEADLESS=True
SCRAPER_MAX_SCROLLS=5
SCRAPER_SCROLL_PAUSE=2

# Default Search Parameters
DEFAULT_ROLE=investor relations
DEFAULT_LOCATION=Mumbai

# Job Sources (comma-separated)
# Available: indeed, naukri, linkedin
JOB_SOURCES=indeed,naukri,linkedin

# Chrome Driver Path (optional, leave empty for auto-detection)
CHROMEDRIVER_PATH=

# Logging
LOG_LEVEL=INFO
LOG_FILE=scraper.log

# Output Settings
OUTPUT_FOLDER=.
FILTERED_JOBS_FILE=investor_relations_mumbai.json
RAW_JOBS_FILE=jobs_raw.json
